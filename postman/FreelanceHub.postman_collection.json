{
  "info": {
    "name": "FreelanceHub API",
    "description": "Run top-to-bottom with the Collection Runner (cookies are kept per host, so each Login request switches the active session). Covers GET/POST/PUT/DELETE and 200/201/204/400/401/403/404/409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "projectId2",
      "value": ""
    },
    {
      "key": "bidId",
      "value": ""
    },
    {
      "key": "tempUserId",
      "value": "0"
    },
    {
      "key": "tempCategoryId",
      "value": "0"
    }
  ],
